# Copy to .env.local and fill in real values. NEVER commit .env.local.
# ---- Neon Postgres ----
# Pooled connection string, used at runtime by the app.
DATABASE_URL=
# Direct (unpooled) connection string, used by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED=

# ---- Neon Auth (Stack Auth) ----
NEXT_PUBLIC_STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=
STACK_SECRET_SERVER_KEY=

# ---- First Admin seed (used only by `npm run seed:admin`) ----
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
