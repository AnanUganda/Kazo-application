# Copy to .env.local and fill in real values. NEVER commit .env.local.
# ---- Supabase Postgres ----
# Pooled (transaction) connection string — host contains "pooler", port 6543.
# Used by the app at runtime.
DATABASE_URL=
# Direct connection string — port 5432. Used by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED=

# ---- Supabase Auth ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key (server-only, used to create staff accounts). Keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# ---- First Admin seed (used only by `npm run seed:admin`) ----
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
